# Passphrase that unlocks admin mode at /admin
UNINSTAGRAM_ADMIN_CODE=change-me

# Secret used to sign the admin cookie
UNINSTAGRAM_SECRET=please-generate-a-long-random-string

# Storage driver: "json" (local files) | "azure" (the container image only)
UNINSTAGRAM_STORE=json

# Burned into the bottom-right of every uploaded photo.
# Leave blank to use "© <your profile name>".
UNINSTAGRAM_WATERMARK=

# White frame burned around each uploaded photo, as a % of its longest edge.
# Blank uses the default (2.2). Set to 0 for no frame.
UNINSTAGRAM_BORDER_PERCENT=
